# Copiado automáticamente a .env por `pnpm bootstrap` si .env no existe.
# Valores SOLO para desarrollo local. En producción definir variables reales.

NODE_ENV=development

# PostgreSQL (infra/docker-compose.yml expone el puerto 5433 en el host)
DATABASE_URL=postgres://bakery:bakery@localhost:5433/bakery_erp
# Base usada por los tests de integración (se crea automáticamente)
DATABASE_URL_TEST=postgres://bakery:bakery@localhost:5433/bakery_erp_test

# API
API_PORT=4000
API_HOST=127.0.0.1
LOG_LEVEL=info
SESSION_TTL_HOURS=12
# Orígenes aceptados para requests que modifican estado (protección CSRF por Origin)
WEB_ORIGIN=http://localhost:3000
# Intentos de login por IP por minuto
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Web (Next.js). URL interna con la que el servidor web llama a la API.
API_INTERNAL_URL=http://127.0.0.1:4000

# Seed de desarrollo (NUNCA usar en producción)
SEED_ADMIN_EMAIL=admin@panificadora.local
SEED_ADMIN_PASSWORD=admin1234
