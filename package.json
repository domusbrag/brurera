{
  "name": "bakery-erp",
  "private": true,
  "version": "0.0.0",
  "description": "ERP vertical para panificadoras — monolito modular",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "bootstrap": "node scripts/ensure-env.mjs && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "dev": "pnpm bootstrap && pnpm --parallel --filter @bakery/api --filter @bakery/web dev",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:reset": "docker compose -f infra/docker-compose.yml down -v && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "db:generate": "pnpm --filter @bakery/database db:generate",
    "db:migrate": "pnpm --filter @bakery/database db:migrate",
    "db:seed": "pnpm --filter @bakery/api db:seed",
    "db:sync-reference": "pnpm --filter @bakery/database db:sync-reference",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "pnpm build && playwright test",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "dotenv": "^18.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
